{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Student record in the institute",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Student full name", "maxLength": 150 },
        "roll": { "type": "string", "description": "Student board roll number", "maxLength": 20 },
        "registration": { "type": "string", "description": "Student registration number", "maxLength": 30 },
        "studentId": { "type": "string", "description": "Unique student institutional ID", "maxLength": 50 },
        "departmentId": { "type": "string", "description": "Department key (e.g. cmt, ct)", "maxLength": 30 },
        "departmentName": { "type": "string", "description": "Department name in Bengali", "maxLength": 100 },
        "semesterId": { "type": "string", "description": "Semester ID (1 to 8)", "maxLength": 5 },
        "shift": { "type": "string", "description": "Shift name (e.g. ১ম শিফট)", "maxLength": 30 },
        "session": { "type": "string", "description": "Academic session (e.g. ২০২৩-২৪)", "maxLength": 30 },
        "status": { "type": "string", "description": "Student status (ACTIVE or INACTIVE)", "enum": ["ACTIVE", "INACTIVE"] },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "updatedAt": { "type": "number", "description": "Update timestamp in milliseconds" }
      },
      "required": ["name", "roll", "studentId", "departmentId", "departmentName", "semesterId", "status"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Exam definition including subjects and total marks",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Exam title", "maxLength": 200 },
        "semesterId": { "type": "string", "description": "Semester ID (1 to 8)", "maxLength": 5 },
        "departmentId": { "type": "string", "description": "Department key (e.g. cmt, ct)", "maxLength": 30 },
        "departmentName": { "type": "string", "description": "Department name in Bengali", "maxLength": 100 },
        "examType": { "type": "string", "description": "Exam type category", "maxLength": 50 },
        "examDate": { "type": "string", "description": "Exam date string (YYYY-MM-DD)", "maxLength": 30 },
        "totalMarks": { "type": "number", "description": "Total marks for the exam" },
        "description": { "type": "string", "description": "Exam details and instructions", "maxLength": 1000 },
        "subjects": { "type": "array", "description": "List of subjects included in exam" },
        "status": { "type": "string", "description": "Exam status", "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"] },
        "allowMeritList": { "type": "boolean", "description": "Whether to generate merit list" },
        "publishedAt": { "type": "number", "description": "Publication timestamp in milliseconds" },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "updatedAt": { "type": "number", "description": "Update timestamp in milliseconds" }
      },
      "required": ["title", "semesterId", "departmentId", "departmentName", "examType", "examDate", "totalMarks", "status"]
    },
    "StudentResult": {
      "title": "StudentResult",
      "description": "Published or draft result of a student for an exam",
      "type": "object",
      "properties": {
        "examId": { "type": "string", "description": "Linked exam document ID", "maxLength": 128 },
        "examTitle": { "type": "string", "description": "Title of the exam", "maxLength": 200 },
        "examType": { "type": "string", "description": "Exam type category", "maxLength": 50 },
        "examDate": { "type": "string", "description": "Exam date string", "maxLength": 30 },
        "semesterId": { "type": "string", "description": "Semester ID (1 to 8)", "maxLength": 5 },
        "departmentId": { "type": "string", "description": "Department key", "maxLength": 30 },
        "departmentName": { "type": "string", "description": "Department name", "maxLength": 100 },
        "studentId": { "type": "string", "description": "Institutional Student ID", "maxLength": 50 },
        "studentDocId": { "type": "string", "description": "Firestore student document ID", "maxLength": 128 },
        "roll": { "type": "string", "description": "Student roll number", "maxLength": 20 },
        "registration": { "type": "string", "description": "Student registration number", "maxLength": 30 },
        "studentName": { "type": "string", "description": "Student name", "maxLength": 150 },
        "subjects": { "type": "array", "description": "Individual subject scores and grades" },
        "totalFullMarks": { "type": "number", "description": "Sum of subject full marks" },
        "totalObtainedMarks": { "type": "number", "description": "Sum of obtained marks" },
        "gpa": { "type": "number", "description": "Calculated GPA (0.00 to 4.00)" },
        "letterGrade": { "type": "string", "description": "Letter grade (A+, A, B, etc.)", "maxLength": 10 },
        "isPassed": { "type": "boolean", "description": "Pass or fail status" },
        "meritRank": { "type": "number", "description": "Rank in exam merit list" },
        "status": { "type": "string", "description": "Result status", "enum": ["DRAFT", "REVIEW", "PUBLISHED"] },
        "publishedAt": { "type": "number", "description": "Publication timestamp in milliseconds" },
        "verificationCode": { "type": "string", "description": "Unique verification code for authentication", "maxLength": 60 },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "updatedAt": { "type": "number", "description": "Update timestamp in milliseconds" }
      },
      "required": ["examId", "examTitle", "roll", "studentName", "semesterId", "departmentId", "gpa", "letterGrade", "status", "verificationCode"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Institute notice or circular",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Notice headline", "maxLength": 250 },
        "content": { "type": "string", "description": "Notice body text", "maxLength": 5000 },
        "publishedDate": { "type": "string", "description": "Published date string", "maxLength": 50 },
        "category": { "type": "string", "description": "Notice category", "enum": ["EXAM", "RESULT", "GENERAL", "URGENT"] },
        "isPinned": { "type": "boolean", "description": "Pinned status for top banner display" },
        "status": { "type": "string", "description": "Notice status", "enum": ["PUBLISHED", "DRAFT"] },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "updatedAt": { "type": "number", "description": "Update timestamp in milliseconds" }
      },
      "required": ["title", "content", "category", "status"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "General portal configuration and grading policies",
      "type": "object",
      "properties": {
        "instituteName": { "type": "string", "description": "Institute name in Bengali", "maxLength": 200 },
        "portalTitle": { "type": "string", "description": "Portal banner title", "maxLength": 100 },
        "tagline": { "type": "string", "description": "Institute tagline", "maxLength": 200 },
        "logoUrl": { "type": "string", "description": "Logo image URL", "maxLength": 500 },
        "contactEmail": { "type": "string", "description": "Contact email address", "maxLength": 100 },
        "contactPhone": { "type": "string", "description": "Contact phone number", "maxLength": 50 },
        "noticeMarquee": { "type": "string", "description": "Live scrolling marquee text", "maxLength": 500 },
        "gradingRules": { "type": "array", "description": "Grading rules matrix" },
        "departments": { "type": "array", "description": "List of active engineering departments" },
        "examTypes": { "type": "array", "description": "List of exam type categories" },
        "shifts": { "type": "array", "description": "List of dynamic shift configurations with start and end times" },
        "updatedAt": { "type": "number", "description": "Update timestamp in milliseconds" }
      },
      "required": ["instituteName", "portalTitle"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator document",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Admin email address", "maxLength": 150 },
        "role": { "type": "string", "description": "Role description", "maxLength": 50 },
        "createdAt": { "type": "number", "description": "Creation timestamp" }
      },
      "required": ["email"]
    },
    "CurriculumSubject": {
      "title": "CurriculumSubject",
      "description": "Master curriculum subject entry referencing BTEB syllabus",
      "type": "object",
      "properties": {
        "technology": { "type": "string", "description": "Engineering technology name (CIVIL, COMPUTER, etc.)", "maxLength": 50 },
        "semester": { "type": "string", "description": "Semester title (1st, 2nd, etc.)", "maxLength": 10 },
        "semesterId": { "type": "string", "description": "Semester ID (1 to 8)", "maxLength": 5 },
        "subjectCode": { "type": "string", "description": "Curriculum official subject code", "maxLength": 20 },
        "subjectName": { "type": "string", "description": "Curriculum official subject name in Bengali", "maxLength": 150 },
        "curriculumFullMarks": { "type": "number", "description": "Reference curriculum total marks from syllabus" }
      },
      "required": ["technology", "semester", "semesterId", "subjectCode", "subjectName", "curriculumFullMarks"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Faculty member record",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Teacher full name", "maxLength": 150 },
        "designation": { "type": "string", "description": "Teacher designation", "maxLength": 100 },
        "departmentId": { "type": "string", "description": "Department key", "maxLength": 30 },
        "departmentName": { "type": "string", "description": "Department name", "maxLength": 100 },
        "phone": { "type": "string", "description": "Contact phone number", "maxLength": 50 },
        "email": { "type": "string", "description": "Contact email", "maxLength": 100 }
      },
      "required": ["name", "designation", "departmentId"]
    },
    "AppEvent": {
      "title": "AppEvent",
      "description": "Institute academic or institutional event",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Event title", "maxLength": 200 },
        "eventType": { "type": "string", "description": "Event category", "maxLength": 50 },
        "eventTypeName": { "type": "string", "description": "Category name in Bengali", "maxLength": 50 },
        "eventDate": { "type": "string", "description": "Event date (YYYY-MM-DD)", "maxLength": 30 },
        "startTime": { "type": "string", "description": "Event start time", "maxLength": 30 },
        "endTime": { "type": "string", "description": "Event end time", "maxLength": 30 },
        "location": { "type": "string", "description": "Location/Room", "maxLength": 150 },
        "description": { "type": "string", "description": "Event details", "maxLength": 1000 },
        "status": { "type": "string", "description": "Event status", "enum": ["PUBLISHED", "DRAFT"] },
        "isPinned": { "type": "boolean", "description": "Pinned status" }
      },
      "required": ["title", "eventType", "eventDate", "status"]
    },
    "NotificationSubscription": {
      "title": "NotificationSubscription",
      "description": "FCM Web Push token and notification subscription preferences",
      "type": "object",
      "properties": {
        "token": { "type": "string", "description": "FCM device registration token", "maxLength": 500 },
        "deviceType": { "type": "string", "description": "Device type (mobile, tablet, desktop)", "maxLength": 30 },
        "browser": { "type": "string", "description": "Browser name", "maxLength": 50 },
        "userAgent": { "type": "string", "description": "Browser User-Agent string", "maxLength": 500 },
        "preferredDepartment": { "type": "string", "description": "Preferred technology/department filter", "maxLength": 50 },
        "preferredSemester": { "type": "string", "description": "Preferred semester ID filter", "maxLength": 10 },
        "status": { "type": "string", "description": "Subscription status", "enum": ["ACTIVE", "MUTED"] },
        "createdAt": { "type": "number", "description": "Subscription timestamp in milliseconds" },
        "updatedAt": { "type": "number", "description": "Update timestamp in milliseconds" }
      },
      "required": ["token", "status"]
    },
    "ClassRoutine": {
      "title": "ClassRoutine",
      "description": "Weekly class timetable routine for technology and semester",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Routine title", "maxLength": 200 },
        "technology": { "type": "string", "description": "Department technology code", "maxLength": 50 },
        "technologyName": { "type": "string", "description": "Technology name in Bengali", "maxLength": 100 },
        "semesterId": { "type": "string", "description": "Semester ID", "maxLength": 10 },
        "shift": { "type": "string", "description": "Shift name", "maxLength": 30 },
        "academicYear": { "type": "string", "description": "Academic year or session", "maxLength": 30 },
        "effectiveDate": { "type": "string", "description": "Date from which routine is effective", "maxLength": 30 },
        "periodTimes": { "type": "array", "description": "Configured period timings" },
        "timetable": { "type": "object", "description": "Weekly timetable slots mapping" },
        "status": { "type": "string", "description": "Status (PUBLISHED or DRAFT)", "enum": ["PUBLISHED", "DRAFT"] },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "updatedAt": { "type": "number", "description": "Update timestamp in milliseconds" }
      },
      "required": ["technology", "semesterId", "timetable", "status"]
    },
    "ExamRoutine": {
      "title": "ExamRoutine",
      "description": "Official examination routine with dates, timings, rooms and subjects",
      "type": "object",
      "properties": {
        "examId": { "type": "string", "description": "Linked exam ID", "maxLength": 128 },
        "examTitle": { "type": "string", "description": "Exam title", "maxLength": 200 },
        "technology": { "type": "string", "description": "Technology filter if specific", "maxLength": 50 },
        "semesterId": { "type": "string", "description": "Semester filter if specific", "maxLength": 10 },
        "routineItems": { "type": "array", "description": "Array of examination schedule items" },
        "status": { "type": "string", "description": "Status (PUBLISHED or DRAFT)", "enum": ["PUBLISHED", "DRAFT"] },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "updatedAt": { "type": "number", "description": "Update timestamp in milliseconds" }
      },
      "required": ["examId", "examTitle", "routineItems", "status"]
    },
    "QuestionPaper": {
      "title": "QuestionPaper",
      "description": "Standardized examination question paper with sections and marks",
      "type": "object",
      "properties": {
        "examTitle": { "type": "string", "description": "Exam title", "maxLength": 200 },
        "subjectCode": { "type": "string", "description": "Curriculum subject code", "maxLength": 20 },
        "subjectName": { "type": "string", "description": "Subject name in Bengali", "maxLength": 150 },
        "technology": { "type": "string", "description": "Technology name", "maxLength": 50 },
        "semester": { "type": "string", "description": "Semester", "maxLength": 30 },
        "fullMarks": { "type": "number", "description": "Total examination marks" },
        "duration": { "type": "string", "description": "Exam duration string", "maxLength": 50 },
        "instructions": { "type": "string", "description": "Exam instructions", "maxLength": 1000 },
        "departments": { "type": "array", "description": "Applicable departments" },
        "groups": { "type": "array", "description": "Question groups (ক বিভাগ, খ বিভাগ, গ বিভাগ) with questions" },
        "status": { "type": "string", "description": "Status (PUBLISHED or DRAFT)", "enum": ["PUBLISHED", "DRAFT"] },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "updatedAt": { "type": "number", "description": "Update timestamp in milliseconds" }
      },
      "required": ["examTitle", "subjectCode", "subjectName", "fullMarks", "groups", "status"]
    },
    "AdmissionApplicant": {
      "title": "AdmissionApplicant",
      "description": "Student applicant user account for online admission portal",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "description": "Full name of the applicant", "maxLength": 150 },
        "phone": { "type": "string", "description": "Mobile phone number", "maxLength": 20 },
        "email": { "type": "string", "description": "Email address if provided", "maxLength": 100 },
        "sscRoll": { "type": "string", "description": "SSC or equivalent roll number", "maxLength": 20 },
        "sscBoard": { "type": "string", "description": "SSC educational board name", "maxLength": 50 },
        "sscPassingYear": { "type": "string", "description": "SSC passing year", "maxLength": 10 },
        "passwordHash": { "type": "string", "description": "Hashed login password", "maxLength": 128 },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "updatedAt": { "type": "number", "description": "Update timestamp in milliseconds" }
      },
      "required": ["fullName", "phone", "sscRoll", "sscBoard", "sscPassingYear"]
    },
    "AdmissionApplication": {
      "title": "AdmissionApplication",
      "description": "Formal admission application submitted by candidate",
      "type": "object",
      "properties": {
        "applicationTrackingNumber": { "type": "string", "description": "Unique tracking tracking identifier", "maxLength": 50 },
        "applicantId": { "type": "string", "description": "Applicant document ID", "maxLength": 128 },
        "applicantPhone": { "type": "string", "description": "Primary mobile number", "maxLength": 20 },
        "personalInfo": { "type": "object", "description": "Personal details of candidate" },
        "educationalInfo": { "type": "object", "description": "Academic background and SSC scores" },
        "technologyChoices": { "type": "array", "description": "Ordered department/shift preference list" },
        "status": { "type": "string", "description": "Application approval state", "enum": ["PENDING", "VERIFIED", "APPROVED", "REJECTED", "WAITING"] },
        "assignedDepartment": { "type": "string", "description": "Final allocated department if approved", "maxLength": 100 },
        "assignedShift": { "type": "string", "description": "Final allocated shift if approved", "maxLength": 50 },
        "adminRemarks": { "type": "string", "description": "Administrative notes and status feedback", "maxLength": 1000 },
        "submissionDate": { "type": "string", "description": "Submission ISO or formatted date string", "maxLength": 50 },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "updatedAt": { "type": "number", "description": "Update timestamp in milliseconds" }
      },
      "required": ["applicationTrackingNumber", "applicantPhone", "personalInfo", "educationalInfo", "technologyChoices", "status"]
    },
    "AdmissionSettings": {
      "title": "AdmissionSettings",
      "description": "Admission helpline and contact settings",
      "type": "object",
      "properties": {
        "contactPhone": { "type": "string", "description": "One or multiple helpline contact numbers", "maxLength": 200 },
        "helplineTitle": { "type": "string", "description": "Helpline heading text", "maxLength": 100 },
        "helplineHours": { "type": "string", "description": "Helpline office hours", "maxLength": 100 },
        "emergencyPhone": { "type": "string", "description": "Emergency hotline number", "maxLength": 50 },
        "address": { "type": "string", "description": "Campus or admission desk address", "maxLength": 300 },
        "updatedAt": { "type": "number", "description": "Update timestamp in milliseconds" }
      },
      "required": ["contactPhone"]
    },
    "AdmissionSecurityLog": {
      "title": "AdmissionSecurityLog",
      "description": "Security audit and fraud detection log for admission operations",
      "type": "object",
      "properties": {
        "eventType": { "type": "string", "description": "Security event type", "maxLength": 50 },
        "severity": { "type": "string", "description": "Severity level", "enum": ["INFO", "WARNING", "CRITICAL"] },
        "deviceFingerprint": { "type": "string", "description": "Device fingerprint hash", "maxLength": 100 },
        "phone": { "type": "string", "description": "Phone number involved", "maxLength": 20 },
        "roll": { "type": "string", "description": "Roll number involved", "maxLength": 20 },
        "applicationId": { "type": "string", "description": "Associated application document ID", "maxLength": 100 },
        "riskScore": { "type": "number", "description": "Calculated risk score 0-100" },
        "riskFactors": { "type": "array", "description": "List of flagged risk factors" },
        "details": { "type": "string", "description": "Event detail description", "maxLength": 1000 },
        "timestamp": { "type": "number", "description": "Event timestamp in milliseconds" }
      },
      "required": ["eventType", "severity", "timestamp"]
    },
    "AdmissionRateLimit": {
      "title": "AdmissionRateLimit",
      "description": "Firestore-synced rate limit tracking bucket for device and phone submissions",
      "type": "object",
      "properties": {
        "key": { "type": "string", "description": "Rate limit identifier key (device fingerprint or phone)", "maxLength": 100 },
        "type": { "type": "string", "description": "Limit key type (DEVICE or PHONE)", "maxLength": 20 },
        "attempts": { "type": "number", "description": "Number of attempts within current window" },
        "firstAttemptAt": { "type": "number", "description": "Timestamp of initial attempt in window" },
        "lastAttemptAt": { "type": "number", "description": "Timestamp of most recent attempt" },
        "blockedUntil": { "type": "number", "description": "Timestamp until which requests are blocked" },
        "updatedAt": { "type": "number", "description": "Update timestamp in milliseconds" }
      },
      "required": ["key", "attempts", "lastAttemptAt"]
    },
    "AcademicBook": {
      "title": "AcademicBook",
      "description": "Textbook and curriculum book definition for diploma engineering technology and semester",
      "type": "object",
      "properties": {
        "technology": { "type": "string", "description": "Technology / Department code (e.g. cmt, ct, et)", "maxLength": 50 },
        "technologyName": { "type": "string", "description": "Technology name in Bengali", "maxLength": 100 },
        "semesterId": { "type": "string", "description": "Semester ID (1 to 8)", "maxLength": 10 },
        "semesterName": { "type": "string", "description": "Semester name in Bengali (e.g. ১ম পর্ব)", "maxLength": 50 },
        "subjectCode": { "type": "string", "description": "Official BTEB curriculum subject code", "maxLength": 20 },
        "subjectName": { "type": "string", "description": "Book or subject title in Bengali/English", "maxLength": 150 },
        "credit": { "type": "number", "description": "Academic credit value (e.g. 2, 3, 4)" },
        "tpc": { "type": "string", "description": "Theory-Practical-Credit specification (e.g. 2-3-3)", "maxLength": 20 },
        "marketPrice": { "type": "number", "description": "Optional approximate book market price in BDT. If omitted or 0, not displayed to students." },
        "author": { "type": "string", "description": "Author name or committee", "maxLength": 150 },
        "publisher": { "type": "string", "description": "Publisher or press name (e.g. হক পাবলিকেশন, টেকনিক্যাল)", "maxLength": 150 },
        "edition": { "type": "string", "description": "Syllabus regulation or edition (e.g. প্রবিধান ২০২২)", "maxLength": 100 },
        "bookType": { "type": "string", "description": "Subject type category (COMPULSORY, ELECTIVE, OPTIONAL)", "maxLength": 50 },
        "description": { "type": "string", "description": "Special book notes or syllabus outline", "maxLength": 1000 },
        "status": { "type": "string", "description": "Active or draft status", "enum": ["ACTIVE", "INACTIVE"] },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "updatedAt": { "type": "number", "description": "Update timestamp in milliseconds" }
      },
      "required": ["technology", "semesterId", "subjectCode", "subjectName", "status"]
    }
  },
  "firestore": {
    "/books/{bookId}": {
      "schema": { "$ref": "AcademicBook" },
      "description": "Semester and technology textbooks list with optional market prices and credit information"
    },
    "/admission_security_logs/{logId}": {
      "schema": { "$ref": "AdmissionSecurityLog" },
      "description": "Firestore-synced security and fraud audit event logs"
    },
    "/admission_rate_limits/{limitId}": {
      "schema": { "$ref": "AdmissionRateLimit" },
      "description": "Firestore-synced rate limiting tracking documents"
    },
    "/admission_applicants/{applicantId}": {
      "schema": { "$ref": "AdmissionApplicant" },
      "description": "Student applicant accounts and credentials"
    },
    "/admission_applications/{applicationId}": {
      "schema": { "$ref": "AdmissionApplication" },
      "description": "Diploma admission applications submitted by students"
    },
    "/admission_settings/{settingId}": {
      "schema": { "$ref": "AdmissionSettings" },
      "description": "Institutional admission helpline numbers and desk schedule"
    },
    "/class_routines/{routineId}": {
      "schema": { "$ref": "ClassRoutine" },
      "description": "Weekly class routines and timetables for students and teachers"
    },
    "/exam_routines/{routineId}": {
      "schema": { "$ref": "ExamRoutine" },
      "description": "Examination routines with dates, timings, rooms, and subjects"
    },
    "/question_papers/{paperId}": {
      "schema": { "$ref": "QuestionPaper" },
      "description": "Standardized question papers designed and saved by faculty/admins"
    },
    "/notification_subscriptions/{subscriptionId}": {
      "schema": { "$ref": "NotificationSubscription" },
      "description": "Store web push notification subscription tokens for result and notice broadcasts"
    },
    "/curriculum/{curriculumId}": {
      "schema": { "$ref": "CurriculumSubject" },
      "description": "Master curriculum subjects collection accessible for academic operations"
    },
