# Environment Variables Example for DPIB RESULT ZONE

# Google Gemini API Key for Server-Side AI Assistant
GEMINI_API_KEY=

# Firebase Client Configuration (Optional overrides; defaults in firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server Configuration
PORT=3000
NODE_ENV=development
